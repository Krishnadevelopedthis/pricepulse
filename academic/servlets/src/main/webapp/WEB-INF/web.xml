<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>PricePulse academic web module</display-name>
  <context-param><param-name>appName</param-name><param-value>PricePulse Academic</param-value></context-param>
  <session-config><session-timeout>15</session-timeout><cookie-config><http-only>true</http-only></cookie-config></session-config>
  <error-page><exception-type>jakarta.servlet.ServletException</exception-type><location>/WEB-INF/views/error.jsp</location></error-page>
  <error-page><error-code>404</error-code><location>/WEB-INF/views/error.jsp</location></error-page>
</web-app>
