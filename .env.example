# Copy to .env (never commit .env). Used by docker-compose files.

# --- MongoDB ---
# Local/VPS compose stack creates its own MongoDB with this user:
MONGO_USER=pricepulse
MONGO_PASSWORD=change-me-to-a-long-random-string
# Managed MongoDB (Atlas): set this instead and remove the mongo service.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pricepulse?retryWrites=true&w=majority

# --- Backend ---
# Allowed origins for CORS. After publishing, pin to your extension: chrome-extension://<EXTENSION_ID>
PRICEPULSE_CORS_ORIGINS=chrome-extension://*
PRICEPULSE_CHECK_INTERVAL_MINUTES=60

# --- Production only (deploy/docker-compose.prod.yml) ---
DOMAIN=api.example.com
